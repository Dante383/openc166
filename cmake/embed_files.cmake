# Writes a C++ fragment that holds files as byte arrays (MSVC limits string
# literals to 16 KB, byte arrays have no such limit).
#
#   cmake -DOUTPUT=<file.inc> "-DFILES=<a>|<b>" -P embed_files.cmake
#
# The fragment defines kEmbedded[], an array of {name, data, size}.
string(REPLACE "|" ";" files "${FILES}")
set(arrays "")
set(table "")
set(i 0)
foreach(f IN LISTS files)
    file(READ "${f}" hex HEX)
    # 16 bytes per line.
    string(REGEX REPLACE "(................................)" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    get_filename_component(name "${f}" NAME)
    string(APPEND arrays "const unsigned char kData${i}[] = {\n${hex}};\n\n")
    string(APPEND table "    {\"${name}\", kData${i}, sizeof kData${i}},\n")
    math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUTPUT}"
    "// Generated by cmake/embed_files.cmake. Do not edit.\n\n"
    "${arrays}"
    "const EmbeddedFile kEmbedded[] = {\n${table}};\n")
