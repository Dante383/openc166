$NOMACRO
$CASE
$MOD167
$INCLUDE(REG167.INC)
FPUTS_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fputs
_fputs:
; %bb.0:                                ; %entry
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R6, R13
	MOV	R7, R12
	CALL	_strlen
	MOV	R8, R4
	MOV	R12, [R6]
	MOV	R13, R7
	MOV	R14, R8
	CALL	__write
	MOV	R5, R4
	MOV	R4, #0
	CMP	R5, R8
	JMP	cc_EQ, ?LBB0_2
; %bb.1:                                ; %if.then
	MOVB	RL4, [R6+#4]
	OR	R4, #2
	MOVB	[R6+#4], RL4
	MOV	R4, #65535
?LBB0_2:
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	RET
	PUBLIC	_puts
_puts:
; %bb.0:                                ; %entry
	MOV	R13, #___c166_iob+6
	CALL	_fputs
	CMP	R4, #65535
	JMP	cc_EQ, ?LBB1_4
; %bb.1:                                ; %if.end
	MOV	R12, #10
	MOV	R13, #___c166_iob+6
	CALL	_fputc
	MOV	R5, R4
	MOV	R4, #65535
	CMP	R5, #65535
	JMP	cc_EQ, ?LBB1_3
; %bb.2:                                ; %if.end
	MOV	R4, #0
?LBB1_3:
	RET
?LBB1_4:
	MOV	R4, #65535
	RET
	EXTRN	_strlen : NEAR
	EXTRN	__write : NEAR
	EXTRN	___c166_iob : WORD
	EXTRN	_fputc : NEAR
FPUTS_PR	ENDS
	END
