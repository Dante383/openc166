$NOMACRO
$CASE
$MOD167
$INCLUDE(REG167.INC)
STRCAT_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strcat
_strcat:
; %bb.0:                                ; %entry
	MOV	R4, R12
	MOV	R5, R4
	SUB	R5, #1
?LBB0_1:
	MOVB	RL1, [R5+#1]
	ADD	R5, #1
	MOVBZ	R1, RL1
	JMP	cc_NE, ?LBB0_1
; %bb.2:                                ; %while.cond1.preheader
	MOV	R1, #0
?LBB0_3:
	MOV	R2, R13
	ADD	R2, R1
	MOV	R3, R5
	ADD	R3, R1
	MOVB	RL2, [R2]
	MOVBZ	R2, RL2
	MOVB	[R3], RL2
	ADD	R1, #1
	CMP	R2, #0
	JMP	cc_NE, ?LBB0_3
; %bb.4:                                ; %while.end6
	RET
STRCAT_PR	ENDS
	END
