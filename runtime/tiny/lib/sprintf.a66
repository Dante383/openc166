$NOMACRO
$CASE
$MOD167
$INCLUDE(REG167.INC)
SPRINTF_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_vsnprintf
_vsnprintf:
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #4
	MOV	R6, R13
	MOV	[R0], R12
	MOV	R4, #1
	CMP	R6, #0
	JMP	cc_NE, ?LBB0_2
; %bb.1:                                ; %entry
	MOV	R4, #0
?LBB0_2:
	AND	R4, #1
	MOV	R5, R6
	SUB	R5, R4
	MOV	[R0+#2], R5
	MOV	R12, #_put
	MOV	R13, R0
	CALL	___c166_format
	CMP	R6, #0
	JMP	cc_EQ, ?LBB0_4
; %bb.3:                                ; %if.then
	MOV	R5, [R0]
	MOV	R1, #0
	MOVB	[R5], RL1
?LBB0_4:
	ADD	R0, #4
	MOV	R6, [R0+]
	RET
_put:
; %bb.0:                                ; %entry
	CMP	R14, #0
	JMP	cc_EQ, ?LBB1_4
; %bb.1:                                ; %land.rhs.preheader
	MOV	R4, [R12+#2]
?LBB1_2:
	CMP	R4, #0
	JMP	cc_EQ, ?LBB1_4
; %bb.3:                                ; %for.body
	MOVB	RL4, [R13+]
	MOV	R5, [R12]
	MOV	R1, R5
	ADD	R1, #1
	MOV	[R12], R1
	MOVB	[R5], RL4
	SUB	R14, #1
	MOV	R4, [R12+#2]
	SUB	R4, #1
	MOV	[R12+#2], R4
	CMP	R14, #0
	JMP	cc_NE, ?LBB1_2
?LBB1_4:
	RET
	PUBLIC	_vsprintf
_vsprintf:
; %bb.0:                                ; %entry
	SUB	R0, #4
	MOV	R15, R14
	MOV	R14, R13
	MOV	[R0], R12
	MOV	R4, #65534
	MOV	[R0+#2], R4
	MOV	R12, #_put
	MOV	R13, R0
	CALL	___c166_format
	MOV	R5, [R0]
	MOV	R1, #0
	MOVB	[R5], RL1
	ADD	R0, #4
	RET
	PUBLIC	_snprintf
_snprintf:
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #6
	MOV	R6, R13
	MOV	R15, R0
	ADD	R15, #8
	MOV	[R0], R15
	MOV	[R0+#2], R12
	MOV	R4, #1
	CMP	R6, #0
	JMP	cc_NE, ?LBB3_2
; %bb.1:                                ; %entry
	MOV	R4, #0
?LBB3_2:
	AND	R4, #1
	MOV	R5, R6
	SUB	R5, R4
	MOV	[R0+#4], R5
	MOV	R12, #_put
	MOV	R13, R0
	ADD	R13, #2
	CALL	___c166_format
	CMP	R6, #0
	JMP	cc_EQ, ?LBB3_4
; %bb.3:                                ; %if.then.i
	MOV	R5, [R0+#2]
	MOV	R1, #0
	MOVB	[R5], RL1
?LBB3_4:
	ADD	R0, #6
	MOV	R6, [R0+]
	RET
	PUBLIC	_sprintf
_sprintf:
; %bb.0:                                ; %entry
	SUB	R0, #6
	MOV	R14, R13
	MOV	R15, R0
	ADD	R15, #6
	MOV	[R0], R15
	MOV	[R0+#2], R12
	MOV	R4, #65534
	MOV	[R0+#4], R4
	MOV	R12, #_put
	MOV	R13, R0
	ADD	R13, #2
	CALL	___c166_format
	MOV	R5, [R0+#2]
	MOV	R1, #0
	MOVB	[R5], RL1
	ADD	R0, #6
	RET
	EXTRN	___c166_format : NEAR
SPRINTF_PR	ENDS
	END
