$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRSTR_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strstr
_strstr:
; %bb.0:                                ; %entry
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R5, R13
	MOV	R4, R12
	EXTS	R15, #1
	MOVB	RL1, [R14]
	MOVBZ	R1, RL1
	MOV	R2, R1
	AND	R2, #255
	JMP	cc_EQ, ?LBB0_7
?LBB0_1:
	EXTS	R5, #1
	MOVB	RL2, [R4]
	MOVBZ	R2, RL2
	AND	R2, #255
	JMP	cc_EQ, ?LBB0_6
; %bb.2:                                ; %land.rhs.preheader
	MOV	R6, R1
	MOV	R2, R14
	MOV	R3, R15
	MOV	R10, R4
	MOV	R11, R5
?LBB0_3:
	EXTS	R11, #1
	MOVB	RL7, [R10]
	MOVBZ	R7, RL7
	AND	R7, #255
	AND	R6, #255
	CMP	R7, R6
	JMP	cc_NE, ?LBB0_5
; %bb.4:                                ; %while.body
	ADD	R10, #1
	ADDC	R11, #0
	ADD	R2, #1
	ADDC	R3, #0
	EXTS	R3, #1
	MOVB	RL6, [R2]
	MOVBZ	R6, RL6
	MOV	R7, R6
	AND	R7, #255
	JMP	cc_NE, ?LBB0_3
	JMP	cc_UC, ?LBB0_7
?LBB0_5:
	ADD	R4, #1
	ADDC	R5, #0
	JMP	cc_UC, ?LBB0_1
?LBB0_6:
	MOV	R4, #0
	MOV	R5, R4
?LBB0_7:
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	RET
STRSTR_PR	ENDS
	END
