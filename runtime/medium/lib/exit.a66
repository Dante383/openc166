$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
EXIT_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_atexit
_atexit:
; %bb.0:                                ; %entry
	EXTS	#SEG _count, #1
	MOV	R5, SOF _count
	MOV	R4, #65535
	CMP	R5, #8
	JMP	cc_EQ, ?LBB0_2
; %bb.1:                                ; %if.end
	MOV	R4, R5
	ADD	R4, #1
	EXTS	#SEG _count, #1
	MOV	SOF _count, R4
	MOV	R4, R5
	SHR	R4, #15
	SHL	R5, #1
	MOV	R1, #SEG _handlers
	MOV	R2, #SOF _handlers
	ADD	R5, R2
	ADDC	R4, R1
	EXTS	R4, #1
	MOV	[R5], R12
	MOV	R4, #0
?LBB0_2:
	RET
	PUBLIC	_exit
_exit:
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	MOV	R6, R12
?LBB1_1:
	EXTS	#SEG _count, #1
	MOV	R4, SOF _count
	CMP	R4, #0
	JMP	cc_EQ, ?LBB1_3
; %bb.2:                                ; %while.body
	SUB	R4, #1
	EXTS	#SEG _count, #1
	MOV	SOF _count, R4
	MOV	R5, R4
	SHR	R5, #15
	SHL	R4, #1
	MOV	R1, #SEG _handlers
	MOV	R2, #SOF _handlers
	ADD	R4, R2
	ADDC	R5, R1
	EXTS	R5, #1
	MOV	R4, [R4]
	CALLI	cc_UC, [R4]
	JMP	cc_UC, ?LBB1_1
?LBB1_3:
	MOV	R12, R6
	CALL	__exit
EXIT_PR	ENDS
C166_HBSS	SECTION	HDATA WORD PUBLIC 'CHUGE'
	EVEN
_count:
	DSB	2
	EVEN
_handlers:
	DSB	16
	EXTRN	__exit : NEAR
C166_HBSS	ENDS
	END
