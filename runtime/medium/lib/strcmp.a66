$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRCMP_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strcmp
_strcmp:
; %bb.0:                                ; %entry
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOV	R5, R4
	AND	R5, #255
	JMP	cc_EQ, ?LBB0_5
?LBB0_1:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	AND	R5, #255
	MOV	R1, R4
	AND	R1, #255
	CMP	R1, R5
	JMP	cc_NE, ?LBB0_4
; %bb.2:                                ; %while.body
	ADD	R12, #1
	ADDC	R13, #0
	ADD	R14, #1
	ADDC	R15, #0
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOV	R5, R4
	AND	R5, #255
	JMP	cc_NE, ?LBB0_1
; %bb.3:
	MOV	R4, #0
?LBB0_4:
	AND	R4, #255
	JMP	cc_UC, ?LBB0_6
?LBB0_5:
	MOV	R4, #0
?LBB0_6:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	SUB	R4, R5
	RET
	PUBLIC	_strcoll
_strcoll:
; %bb.0:                                ; %entry
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOV	R5, R4
	AND	R5, #255
	JMP	cc_EQ, ?LBB1_5
?LBB1_1:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	AND	R5, #255
	MOV	R1, R4
	AND	R1, #255
	CMP	R1, R5
	JMP	cc_NE, ?LBB1_4
; %bb.2:                                ; %while.body.i
	ADD	R12, #1
	ADDC	R13, #0
	ADD	R14, #1
	ADDC	R15, #0
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOV	R5, R4
	AND	R5, #255
	JMP	cc_NE, ?LBB1_1
; %bb.3:
	MOV	R4, #0
?LBB1_4:
	AND	R4, #255
	JMP	cc_UC, ?LBB1_6
?LBB1_5:
	MOV	R4, #0
?LBB1_6:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	SUB	R4, R5
	RET
STRCMP_PR	ENDS
	END
