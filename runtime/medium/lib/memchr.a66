$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
MEMCHR_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_memchr
_memchr:
; %bb.0:                                ; %entry
	MOV	R1, R14
	MOV	R5, R13
	MOV	R4, R12
	CMP	R15, #0
	JMP	cc_EQ, ?LBB0_4
; %bb.1:                                ; %for.body.lr.ph
	MOVBZ	R1, RL1
?LBB0_2:
	EXTS	R5, #1
	MOVB	RL2, [R4]
	MOVBZ	R2, RL2
	MOVBZ	R2, RL2
	CMP	R2, R1
	JMP	cc_EQ, ?LBB0_5
; %bb.3:                                ; %for.inc
	SUB	R15, #1
	ADD	R4, #1
	ADDC	R5, #0
	CMP	R15, #0
	JMP	cc_NE, ?LBB0_2
?LBB0_4:
	MOV	R4, #0
	MOV	R5, R4
?LBB0_5:
	RET
MEMCHR_PR	ENDS
	END
