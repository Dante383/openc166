$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
FSTATUS_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fflush
_fflush:
; %bb.0:                                ; %entry
	MOV	R4, #0
	RET
	PUBLIC	_feof
_feof:
; %bb.0:                                ; %entry
	ADD	R12, #4
	ADDC	R13, #0
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	AND	R4, #1
	RET
	PUBLIC	_ferror
_ferror:
; %bb.0:                                ; %entry
	ADD	R12, #4
	ADDC	R13, #0
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	AND	R4, #2
	RET
	PUBLIC	_clearerr
_clearerr:
; %bb.0:                                ; %entry
	ADD	R12, #4
	ADDC	R13, #0
	MOV	R4, #0
	EXTS	R13, #1
	MOVB	[R12], RL4
	RET
FSTATUS_PR	ENDS
	END
