$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
FREAD_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fread
_fread:
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #8
	MOV	[R0+#6], R13
	MOV	[R0+#4], R12
	MUL	R15, R14
	MOV	R9, MDL
	MOV	R4, #0
	MOV	R8, R4
	CMP	R9, #0
	JMP	cc_EQ, ?LBB0_6
; %bb.1:                                ; %for.body.preheader
	MOV	[R0], R4
	MOV	[R0+#2], R14
	MOV	R6, [R0+#18]
	MOV	R7, [R0+#16]
	MOV	R8, #0
?LBB0_2:
	MOV	R12, R7
	MOV	R13, R6
	CALL	_fgetc
	CMP	R4, #65535
	JMP	cc_EQ, ?LBB0_5
; %bb.3:                                ; %for.inc
	MOV	R5, #0
	MOV	R1, [R0+#6]
	MOV	R2, [R0+#4]
	ADD	R2, R8
	ADDC	R1, R5
	EXTS	R1, #1
	MOVB	[R2], RL4
	ADD	R8, #1
	CMP	R9, R8
	JMP	cc_NE, ?LBB0_2
; %bb.4:
	MOV	R8, R9
?LBB0_5:
	MOV	R14, [R0+#2]
	MOV	R4, [R0]
?LBB0_6:
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_8
; %bb.7:                                ; %cond.true
	MOV	MDL, R8
	DIVU	R14
	MOV	R4, MDL
?LBB0_8:
	ADD	R0, #8
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RET
	EXTRN	_fgetc : NEAR
FREAD_PR	ENDS
	END
