$NOMACRO
$CASE
$MOD167
$INCLUDE(REG167.INC)
MULDI3_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	___muldi3                       ; -- Begin function __muldi3
___muldi3:                              ; @__muldi3
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #66
	MOV	[R0], R12                       ; 2-byte Folded Spill
	MOV	R4, [R0+#88]
	MOV	[R0+#8], R4                     ; 2-byte Folded Spill
	MOV	R4, [R0+#86]
	MOV	[R0+#6], R4                     ; 2-byte Folded Spill
	MOV	R4, [R0+#84]
	MOV	[R0+#4], R4                     ; 2-byte Folded Spill
	MOV	R4, [R0+#82]
	MOV	[R0+#2], R4                     ; 2-byte Folded Spill
	MOV	R3, [R0+#80]
	MOV	R10, [R0+#78]
	MOV	R11, [R0+#76]
	MOV	R13, [R0+#74]
	MOV	R1, #0
	MOV	[R0+#48], R1
	MOV	[R0+#46], R1
	MOV	[R0+#44], R1
	MOV	[R0+#42], R1
	MOV	R15, R0
	ADD	R15, #58
	MOV	R6, R0
	ADD	R6, #50
	MOV	R12, R0
	ADD	R12, #26
	MOV	R8, R0
	ADD	R8, #10
	MOV	R4, R1
?LBB0_1:                                ; %for.body
                                        ; =>This Inner Loop Header: Depth=1
	MOV	[R0+#40], R1
	MOV	[R0+#38], R1
	MOV	[R0+#36], R1
	MOV	[R0+#34], R1
	MOV	[R0+#26], R13
	MOV	[R0+#28], R11
	MOV	[R0+#30], R10
	MOV	[R0+#32], R3
	MOV	R9, R4
	SHR	R9, #3
	AND	R9, #6
	MOV	R7, R12
	ADD	R7, R9
	MOV	R5, [R7]
	MOV	R14, R4
	AND	R14, #15
	SHR	R5, R14
	MOV	R7, [R7+#2]
	SHL	R7, #1
	MOV	R2, R14
	XOR	R2, #15
	SHL	R7, R2
	OR	R7, R5
	MOV	[R15], R7
	MOV	[R0+#24], R1
	MOV	[R0+#22], R1
	MOV	[R0+#20], R1
	MOV	[R0+#18], R1
	MOV	R5, [R0+#2]                     ; 2-byte Folded Reload
	MOV	[R0+#10], R5
	MOV	R5, [R0+#4]                     ; 2-byte Folded Reload
	MOV	[R0+#12], R5
	MOV	R5, [R0+#6]                     ; 2-byte Folded Reload
	MOV	[R0+#14], R5
	MOV	R5, [R0+#8]                     ; 2-byte Folded Reload
	MOV	[R0+#16], R5
	ADD	R9, R8
	MOV	R5, [R9]
	SHR	R5, R14
	MOV	R14, [R9+#2]
	SHL	R14, #1
	SHL	R14, R2
	OR	R14, R5
	MOV	[R6], R14
	ADD	R4, #16
	ADD	R15, #2
	ADD	R6, #2
	CMP	R4, #64
	JMP	cc_NE, ?LBB0_1
; %bb.2:                                ; %for.cond12.preheader.preheader
	MOV	R4, #0
	MOV	R5, R0
	ADD	R5, #58
	MOV	R1, R0
	ADD	R1, #50
	MOV	R2, R4
	MOV	R3, R4
?LBB0_3:                                ; %for.cond12.preheader
                                        ; =>This Loop Header: Depth=1
                                        ;     Child Loop BB0_4 Depth 2
	MOV	R10, R3
	SHL	R10, #1
	ADD	R10, R5
	MOV	R10, [R10]
	MOV	R11, R1
	MOV	R12, R2
	MOV	R14, R4
	MOV	R13, R4
?LBB0_4:                                ; %for.body16
                                        ;   Parent Loop BB0_3 Depth=1
                                        ; =>  This Inner Loop Header: Depth=2
	MOV	R15, [R11+]
	MULU	R15, R10
	MOV	R6, MDH
	MUL	R15, R10
	MOV	R15, MDL
	MOV	R7, R0
	ADD	R7, #42
	ADD	R7, R12
	MOV	R8, [R7]
	MOV	R9, #0
	ADD	R14, R8
	ADDC	R13, R9
	ADD	R14, R15
	ADDC	R13, R6
	MOV	[R7], R14
	ADD	R12, #2
	MOV	R14, R13
	MOV	R13, R9
	CMP	R12, #8
	JMP	cc_NE, ?LBB0_4
; %bb.5:                                ; %for.cond.cleanup15
                                        ;   in Loop: Header=BB0_3 Depth=1
	ADD	R3, #1
	ADD	R2, #2
	CMP	R3, #4
	JMP	cc_NE, ?LBB0_3
; %bb.6:                                ; %for.cond.cleanup10
	MOV	R4, [R0+#42]
	MOV	R5, [R0+#44]
	MOV	R1, [R0+#46]
	MOV	R2, [R0+#48]
	MOV	R3, [R0]                        ; 2-byte Folded Reload
	MOV	[R3+#6], R2
	MOV	[R3+#4], R1
	MOV	[R3+#2], R5
	MOV	[R3], R4
	ADD	R0, #66
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RET
                                        ; -- End function
MULDI3_PR	ENDS
	END
