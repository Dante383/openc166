$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
PRINTF_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_vfprintf
_vfprintf:
_vfprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #38
	MOV	R15, R13
	MOV	R7, R12
	MOV	[R0+#2], R7
	MOV	R4, #0
	MOV	[R0+#4], R4
	MOV	[R0], R14
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R8, R0
	ADD	R8, #2
	MOV	R14, R8
	CALLS	SEG ___c166_format, SOF ___c166_format
	MOV	R6, R4
	MOV	R12, R8
	CALL	_flush
	MOV	R12, R7
	CALLS	SEG _ferror, SOF _ferror
	CMP	R4, #0
	JMP	cc_EQ, ?LBB0_2
; %bb.1:                                ; %entry
	MOV	R6, #65535
?LBB0_2:
	MOV	R4, R6
	ADD	R0, #38
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	RETS
_vfprintf?F	ENDP
_put:
_put?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R6, R14
	MOV	R7, R13
	MOV	R8, R12
	CMP	R6, #0
	JMP	cc_EQ, ?LBB1_5
; %bb.1:                                ; %while.body.lr.ph
	MOV	R9, R8
	ADD	R9, #4
	MOV	R4, [R8+#2]
?LBB1_2:
	CMP	R4, #32
	JMP	cc_NE, ?LBB1_4
; %bb.3:                                ; %if.then
	MOV	R12, R8
	CALL	_flush
	MOV	R4, [R8+#2]
?LBB1_4:
	SUB	R6, #1
	MOVB	RL5, [R7+]
	MOV	R1, R9
	ADD	R1, R4
	ADD	R4, #1
	MOV	[R8+#2], R4
	MOVB	[R1], RL5
	CMP	R6, #0
	JMP	cc_NE, ?LBB1_2
?LBB1_5:
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
_put?F	ENDP
_flush:
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	MOV	R6, R12
	MOV	R14, [R6+#2]
	JMP	cc_EQ, ?LBB2_3
; %bb.1:                                ; %land.lhs.true
	MOV	R4, [R6]
	MOV	R12, [R4]
	MOV	R13, R6
	ADD	R13, #4
	CALLS	SEG __write, SOF __write
	MOV	R5, [R6+#2]
	CMP	R4, R5
	JMP	cc_EQ, ?LBB2_3
; %bb.2:                                ; %if.then
	MOV	R4, [R6]
	MOVB	RL5, [R4+#4]
	OR	R5, #2
	MOVB	[R4+#4], RL5
?LBB2_3:
	MOV	R4, #0
	MOV	[R6+#2], R4
	MOV	R6, [R0+]
	RET
	PUBLIC	_fprintf
_fprintf:
_fprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #2
	MOV	R14, R0
	ADD	R14, #2
	MOV	[R0], R14
	CALLS	SEG _vfprintf, SOF _vfprintf
	ADD	R0, #2
	RETS
_fprintf?F	ENDP
	PUBLIC	_vprintf
_vprintf:
_vprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R14, R13
	MOV	R13, R12
	MOV	R12, #SOF (___c166_iob+6)
	CALLS	SEG _vfprintf, SOF _vfprintf
	RETS
_vprintf?F	ENDP
	PUBLIC	_printf
_printf:
_printf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #2
	MOV	R13, R12
	MOV	R14, R0
	ADD	R14, #2
	MOV	[R0], R14
	MOV	R12, #SOF (___c166_iob+6)
	CALLS	SEG _vfprintf, SOF _vfprintf
	ADD	R0, #2
	RETS
_printf?F	ENDP
	EXTRN	___c166_format : NEAR
	EXTRN	_ferror : NEAR
	EXTRN	__write : NEAR
	EXTRN	___c166_iob : WORD
PRINTF_PR	ENDS
	END
