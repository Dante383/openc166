$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRNCAT_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strncat
_strncat:
_strncat?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R4, R12
	MOV	R5, R4
	SUB	R5, #1
?LBB0_1:
	MOVB	RL1, [R5+#1]
	ADD	R5, #1
	MOVBZ	R1, RL1
	JMP	cc_NE, ?LBB0_1
; %bb.2:                                ; %for.cond.preheader
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_7
; %bb.3:                                ; %land.rhs.preheader
	MOV	R1, #0
?LBB0_4:
	MOV	R2, R13
	ADD	R2, R1
	MOVB	RL2, [R2]
	MOVBZ	R2, RL2
	JMP	cc_EQ, ?LBB0_6
; %bb.5:                                ; %for.body
	MOV	R3, R5
	ADD	R3, R1
	MOVB	[R3], RL2
	ADD	R1, #1
	CMP	R14, R1
	JMP	cc_NE, ?LBB0_4
?LBB0_6:
	ADD	R5, R1
?LBB0_7:
	MOV	R1, #0
	MOVB	[R5], RL1
	RETS
_strncat?F	ENDP
STRNCAT_PR	ENDS
	END
