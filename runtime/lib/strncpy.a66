$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRNCPY_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strncpy
_strncpy:
_strncpy?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R4, R12
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_6
; %bb.1:                                ; %land.rhs.preheader
	MOV	R5, R4
?LBB0_2:
	MOVB	RL1, [R13]
	MOVBZ	R1, RL1
	JMP	cc_EQ, ?LBB0_4
; %bb.3:                                ; %for.body
	ADD	R13, #1
	MOVB	[R5], RL1
	ADD	R5, #1
	SUB	R14, #1
	JMP	cc_NE, ?LBB0_2
	JMP	cc_UC, ?LBB0_6
?LBB0_4:
	MOV	R1, #0
	MOV	R2, R1
?LBB0_5:
	MOV	R3, R5
	ADD	R3, R2
	MOVB	[R3], RL1
	ADD	R2, #1
	CMP	R14, R2
	JMP	cc_NE, ?LBB0_5
?LBB0_6:
	RETS
_strncpy?F	ENDP
STRNCPY_PR	ENDS
	END
