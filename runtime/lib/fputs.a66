$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
FPUTS_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fputs
_fputs:
_fputs?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R6, R13
	MOV	R7, R12
	CALLS	SEG _strlen, SOF _strlen
	MOV	R8, R4
	MOV	R12, [R6]
	MOV	R13, R7
	MOV	R14, R8
	CALLS	SEG __write, SOF __write
	MOV	R5, R4
	MOV	R4, #0
	CMP	R5, R8
	JMP	cc_EQ, ?LBB0_2
; %bb.1:                                ; %if.then
	MOVB	RL4, [R6+#4]
	OR	R4, #2
	MOVB	[R6+#4], RL4
	MOV	R4, #65535
?LBB0_2:
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	RETS
_fputs?F	ENDP
	PUBLIC	_puts
_puts:
_puts?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R13, #NOF (___c166_iob+6)
	CALLS	SEG _fputs, SOF _fputs
	CMP	R4, #65535
	JMP	cc_EQ, ?LBB1_4
; %bb.1:                                ; %if.end
	MOV	R12, #10
	MOV	R13, #NOF (___c166_iob+6)
	CALLS	SEG _fputc, SOF _fputc
	MOV	R5, R4
	MOV	R4, #65535
	CMP	R5, #65535
	JMP	cc_EQ, ?LBB1_3
; %bb.2:                                ; %if.end
	MOV	R4, #0
?LBB1_3:
	RETS
?LBB1_4:
	MOV	R4, #65535
	RETS
_puts?F	ENDP
	EXTRN	_strlen : FAR
	EXTRN	__write : FAR
	EXTRN	___c166_iob : WORD
	EXTRN	_fputc : FAR
FPUTS_PR	ENDS
	END
