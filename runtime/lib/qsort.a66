$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
QSORT_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_qsort
_qsort:
_qsort?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #12
	MOV	R6, R14
	MOV	[R0+#8], R12
	MOV	R4, #1
	MOV	[R0], R13
	CMP	R13, #6
	JMP	cc_ULT, ?LBB0_3
; %bb.1:                                ; %while.body.preheader
	MOV	R4, #43691
	MOV	R5, [R0]
	MULU	R5, R4
	MOV	R5, MDH
	SHR	R5, #1
	MOV	R4, #1
	MOV	R1, #3
?LBB0_2:
	MUL	R4, R1
	MOV	R4, MDL
	ADD	R4, #1
	CMP	R4, R5
	JMP	cc_ULT, ?LBB0_2
?LBB0_3:
	MOV	R5, [R0+#22]
	MOV	[R0+#6], R5
	MOV	R5, [R0+#20]
	MOV	[R0+#4], R5
?LBB0_4:
	MOV	R10, R4
	MOV	R4, [R0]
	CMP	R10, R4
	JMP	cc_UGE, ?LBB0_13
; %bb.5:                                ; %for.cond5.preheader.preheader
	MOV	R5, R10
	MOV	[R0+#10], R10
?LBB0_6:
	MOV	R8, R5
	MOV	[R0+#2], R5
	CMP	R5, R10
	JMP	cc_ULT, ?LBB0_12
?LBB0_7:
	MUL	R8, R6
	MOV	R9, MDL
	SUB	R8, R10
	MUL	R8, R6
	MOV	R7, MDL
	MOV	R4, [R0+#8]
	ADD	R7, R4
	ADD	R9, R4
	MOV	R12, R7
	MOV	R13, R9
	MOV	R4, [R0+#4]
	MOV	R5, [R0+#6]
	CALLS	SEG ___c166_icall, SOF ___c166_icall
	MOV	R10, [R0+#10]
	CMP	R4, #0
	JMP	cc_SLE, ?LBB0_12
; %bb.8:                                ; %for.body12
	CMP	R6, #0
	JMP	cc_EQ, ?LBB0_11
; %bb.9:                                ; %while.body.i.preheader
	MOV	R4, R6
	MOV	R5, R7
	MOV	R1, R9
?LBB0_10:
	SUB	R4, #1
	MOVB	RL2, [R5+]
	MOVB	RL3, [R1+]
	MOVB	[R7], RL3
	MOVB	[R9], RL2
	MOV	R7, R5
	MOV	R9, R1
	CMP	R4, #0
	JMP	cc_NE, ?LBB0_10
?LBB0_11:
	CMP	R8, R10
	JMP	cc_UGE, ?LBB0_7
?LBB0_12:
	MOV	R5, [R0+#2]
	ADD	R5, #1
	MOV	R4, [R0]
	CMP	R5, R4
	JMP	cc_NE, ?LBB0_6
?LBB0_13:
	MOV	R4, #43691
	MULU	R10, R4
	MOV	R4, MDH
	SHR	R4, #1
	CMP	R10, #3
	JMP	cc_UGE, ?LBB0_4
; %bb.14:                               ; %for.end23
	ADD	R0, #12
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
_qsort?F	ENDP
	EXTRN	___c166_icall : FAR
QSORT_PR	ENDS
	END
