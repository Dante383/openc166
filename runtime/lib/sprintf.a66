$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
SPRINTF_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_vsnprintf
_vsnprintf:
_vsnprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #6
	MOV	R4, R14
	MOV	R6, R13
	MOV	[R0+#2], R12
	MOV	R5, #1
	CMP	R6, #0
	JMP	cc_NE, ?LBB0_2
; %bb.1:                                ; %entry
	MOV	R5, #0
?LBB0_2:
	AND	R5, #1
	MOV	R1, R6
	SUB	R1, R5
	MOV	[R0+#4], R1
	MOV	[R0], R15
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R0
	ADD	R14, #2
	MOV	R15, R4
	CALLS	SEG ___c166_format, SOF ___c166_format
	CMP	R6, #0
	JMP	cc_EQ, ?LBB0_4
; %bb.3:                                ; %if.then
	MOV	R5, [R0+#2]
	MOV	R1, #0
	MOVB	[R5], RL1
?LBB0_4:
	ADD	R0, #6
	MOV	R6, [R0+]
	RETS
_vsnprintf?F	ENDP
_put:
_put?F	PROC	FAR
; %bb.0:                                ; %entry
	CMP	R14, #0
	JMP	cc_EQ, ?LBB1_4
; %bb.1:                                ; %land.rhs.preheader
	MOV	R4, [R12+#2]
?LBB1_2:
	CMP	R4, #0
	JMP	cc_EQ, ?LBB1_4
; %bb.3:                                ; %for.body
	MOVB	RL4, [R13+]
	MOV	R5, [R12]
	MOV	R1, R5
	ADD	R1, #1
	MOV	[R12], R1
	MOVB	[R5], RL4
	SUB	R14, #1
	MOV	R4, [R12+#2]
	SUB	R4, #1
	MOV	[R12+#2], R4
	CMP	R14, #0
	JMP	cc_NE, ?LBB1_2
?LBB1_4:
	RETS
_put?F	ENDP
	PUBLIC	_vsprintf
_vsprintf:
_vsprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #6
	MOV	R15, R13
	MOV	[R0+#2], R12
	MOV	R4, #65534
	MOV	[R0+#4], R4
	MOV	[R0], R14
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R0
	ADD	R14, #2
	CALLS	SEG ___c166_format, SOF ___c166_format
	MOV	R5, [R0+#2]
	MOV	R1, #0
	MOVB	[R5], RL1
	ADD	R0, #6
	RETS
_vsprintf?F	ENDP
	PUBLIC	_snprintf
_snprintf:
_snprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #8
	MOV	R15, R14
	MOV	R6, R13
	MOV	R4, R0
	ADD	R4, #10
	MOV	[R0+#2], R4
	MOV	[R0+#4], R12
	MOV	R5, #1
	CMP	R6, #0
	JMP	cc_NE, ?LBB3_2
; %bb.1:                                ; %entry
	MOV	R5, #0
?LBB3_2:
	AND	R5, #1
	MOV	R1, R6
	SUB	R1, R5
	MOV	[R0+#6], R1
	MOV	[R0], R4
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R0
	ADD	R14, #4
	CALLS	SEG ___c166_format, SOF ___c166_format
	CMP	R6, #0
	JMP	cc_EQ, ?LBB3_4
; %bb.3:                                ; %if.then.i
	MOV	R5, [R0+#4]
	MOV	R1, #0
	MOVB	[R5], RL1
?LBB3_4:
	ADD	R0, #8
	MOV	R6, [R0+]
	RETS
_snprintf?F	ENDP
	PUBLIC	_sprintf
_sprintf:
_sprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #8
	MOV	R15, R13
	MOV	R4, R0
	ADD	R4, #8
	MOV	[R0+#2], R4
	MOV	[R0+#4], R12
	MOV	R5, #65534
	MOV	[R0+#6], R5
	MOV	[R0], R4
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R0
	ADD	R14, #4
	CALLS	SEG ___c166_format, SOF ___c166_format
	MOV	R5, [R0+#4]
	MOV	R1, #0
	MOVB	[R5], RL1
	ADD	R0, #8
	RETS
_sprintf?F	ENDP
	EXTRN	___c166_format : FAR
SPRINTF_PR	ENDS
	END
