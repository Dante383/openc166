$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
MEMCHR_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_memchr
_memchr:
_memchr?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R4, #0
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_4
; %bb.1:                                ; %for.body.lr.ph
	AND	R13, #255
?LBB0_2:
	MOVB	RL5, [R12]
	MOVBZ	R5, RL5
	CMP	R5, R13
	JMP	cc_EQ, ?LBB0_5
; %bb.3:                                ; %for.inc
	SUB	R14, #1
	ADD	R12, #1
	CMP	R14, #0
	JMP	cc_NE, ?LBB0_2
?LBB0_4:
	RETS
?LBB0_5:
	MOV	R4, R12
	RETS
_memchr?F	ENDP
MEMCHR_PR	ENDS
	END
