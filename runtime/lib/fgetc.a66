$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
FGETC_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fgetc
_fgetc:
_fgetc?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #2
	MOV	R6, R12
	MOV	R4, [R6+#2]
	CMP	R4, #65535
	JMP	cc_EQ, ?LBB0_2
; %bb.1:                                ; %if.then
	MOV	R5, #65535
	MOV	[R6+#2], R5
	JMP	cc_UC, ?LBB0_5
?LBB0_2:
	MOV	R12, [R6]
	MOV	R13, R0
	ADD	R13, #1
	MOV	R14, #1
	CALLS	SEG __read, SOF __read
	CMP	R4, #1
	JMP	cc_NE, ?LBB0_4
; %bb.3:                                ; %if.end7
	MOVB	RL4, [R0+#1]
	MOVBZ	R4, RL4
	JMP	cc_UC, ?LBB0_5
?LBB0_4:
	MOVB	RL4, [R6+#4]
	OR	R4, #1
	MOVB	[R6+#4], RL4
	MOV	R4, #65535
?LBB0_5:
	ADD	R0, #2
	MOV	R6, [R0+]
	RETS
_fgetc?F	ENDP
	PUBLIC	_getc
_getc:
_getc?F	PROC	FAR
; %bb.0:                                ; %entry
	CALLS	SEG _fgetc, SOF _fgetc
	RETS
_getc?F	ENDP
	PUBLIC	_getchar
_getchar:
_getchar?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R12, #NOF ___c166_iob
	CALLS	SEG _fgetc, SOF _fgetc
	RETS
_getchar?F	ENDP
	PUBLIC	_ungetc
_ungetc:
_ungetc?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R5, R12
	MOV	R4, #65535
	CMP	R5, #65535
	JMP	cc_EQ, ?LBB3_2
; %bb.1:                                ; %lor.lhs.false
	MOV	R1, [R13+#2]
	CMP	R1, #65535
	JMP	cc_EQ, ?LBB3_3
?LBB3_2:
	RETS
?LBB3_3:
	MOVBZ	R4, RL5
	MOV	[R13+#2], R4
	MOVB	RL5, [R13+#4]
	MOVBZ	R5, RL5
	AND	R5, #254
	MOVB	[R13+#4], RL5
	RETS
_ungetc?F	ENDP
	EXTRN	__read : FAR
	EXTRN	___c166_iob : WORD
FGETC_PR	ENDS
	END
