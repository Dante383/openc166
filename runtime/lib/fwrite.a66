$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
FWRITE_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fwrite
_fwrite:
_fwrite?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R7, R15
	MOV	R6, R13
	MOV	R13, R12
	MOV	R4, #0
	CMP	R6, #0
	JMP	cc_EQ, ?LBB0_5
; %bb.1:                                ; %entry
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_5
; %bb.2:                                ; %if.end
	MOV	R12, [R7]
	MUL	R14, R6
	MOV	R8, MDL
	MOV	R14, R8
	CALLS	SEG __write, SOF __write
	CMP	R4, R8
	JMP	cc_EQ, ?LBB0_4
; %bb.3:                                ; %if.then3
	MOVB	RL5, [R7+#4]
	OR	R5, #2
	MOVB	[R7+#4], RL5
?LBB0_4:
	MOV	MDL, R4
	DIVU	R6
	MOV	R4, MDL
?LBB0_5:
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	RETS
_fwrite?F	ENDP
	EXTRN	__write : NEAR
FWRITE_PR	ENDS
	END
