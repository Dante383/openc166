$NOMACRO
$CASE
MEMMOVE_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_memmove                        ; -- Begin function memmove
_memmove:                               ; @memmove
; %bb.0:                                ; %entry
	MOV	R4, R12
	CMP	R4, R13
	JMP	cc_UGE, ?LBB0_4
; %bb.1:                                ; %while.cond.preheader
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_7
; %bb.2:                                ; %while.body.preheader
	MOV	R5, R4
?LBB0_3:                                ; %while.body
                                        ; =>This Inner Loop Header: Depth=1
	SUB	R14, #1
	MOVB	RL1, [R13]
	ADD	R13, #1
	MOVB	[R5], RL1
	ADD	R5, #1
	CMP	R14, #0
	JMP	cc_NE, ?LBB0_3
	JMP	cc_UC, ?LBB0_7
?LBB0_4:                                ; %if.else
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_7
; %bb.5:                                ; %while.body6.preheader
	SUB	R13, #1
	MOV	R5, R4
	SUB	R5, #1
	MOV	R1, R14
?LBB0_6:                                ; %while.body6
                                        ; =>This Inner Loop Header: Depth=1
	SUB	R1, #1
	MOV	R2, R13
	ADD	R2, R14
	MOVB	RL2, [R2]
	ADD	R14, R5
	MOVB	[R14], RL2
	MOV	R14, R1
	CMP	R1, #0
	JMP	cc_NE, ?LBB0_6
?LBB0_7:                                ; %if.end
	RET
                                        ; -- End function
MEMMOVE_PR	ENDS
	END
