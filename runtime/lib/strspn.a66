$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRSPN_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strspn
_strspn:
_strspn?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	MOVB	RL4, [R12]
	MOVBZ	R2, RL4
	JMP	cc_EQ, ?LBB0_6
; %bb.1:                                ; %while.cond.preheader.lr.ph
	MOVB	RL5, [R13+]
	MOV	R1, #0
	MOVBZ	R3, RL5
	MOV	R4, R1
?LBB0_2:
	MOV	R10, R13
	MOV	R6, R5
	CMP	R3, #0
	JMP	cc_EQ, ?LBB0_8
?LBB0_3:
	MOVBZ	R11, RL2
	MOVBZ	R14, RL6
	CMP	R14, R11
	JMP	cc_EQ, ?LBB0_5
; %bb.4:                                ; %while.cond
	MOVB	RL6, [R10+]
	MOVBZ	R6, RL6
	CMP	R6, #0
	JMP	cc_EQ, ?LBB0_7
	JMP	cc_UC, ?LBB0_3
?LBB0_5:
	ADD	R4, #1
	MOV	R2, R12
	ADD	R2, R4
	MOVB	RL2, [R2]
	MOVBZ	R2, RL2
	JMP	cc_NE, ?LBB0_2
	JMP	cc_UC, ?LBB0_7
?LBB0_6:
	MOV	R4, #0
?LBB0_7:
	MOV	R6, [R0+]
	RETS
?LBB0_8:
	MOV	R4, R1
	JMP	cc_UC, ?LBB0_7
_strspn?F	ENDP
	PUBLIC	_strcspn
_strcspn:
_strcspn?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	MOVB	RL4, [R12]
	MOVBZ	R1, RL4
	JMP	cc_EQ, ?LBB1_6
; %bb.1:                                ; %for.cond1.preheader.lr.ph
	MOVB	RL5, [R13+]
	MOV	R4, #0
	MOVBZ	R2, RL5
?LBB1_2:
	MOV	R3, R13
	MOV	R6, R5
	CMP	R2, #0
	JMP	cc_EQ, ?LBB1_5
?LBB1_3:
	MOVBZ	R10, RL1
	MOVBZ	R11, RL6
	CMP	R11, R10
	JMP	cc_EQ, ?LBB1_7
; %bb.4:                                ; %for.cond1
	MOVB	RL6, [R3+]
	MOVBZ	R6, RL6
	CMP	R6, #0
	JMP	cc_NE, ?LBB1_3
?LBB1_5:
	ADD	R4, #1
	MOV	R1, R12
	ADD	R1, R4
	MOVB	RL1, [R1]
	MOVBZ	R1, RL1
	JMP	cc_NE, ?LBB1_2
	JMP	cc_UC, ?LBB1_7
?LBB1_6:
	MOV	R4, #0
?LBB1_7:
	MOV	R6, [R0+]
	RETS
_strcspn?F	ENDP
	PUBLIC	_strpbrk
_strpbrk:
_strpbrk?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	MOV	R4, R12
	MOVB	RL5, [R4]
	MOVBZ	R2, RL5
	JMP	cc_EQ, ?LBB2_6
; %bb.1:                                ; %for.cond1.preheader.lr.ph.i
	MOVB	RL1, [R13+]
	MOV	R5, #0
	MOVBZ	R3, RL1
?LBB2_2:
	MOV	R10, R13
	MOV	R6, R1
	CMP	R3, #0
	JMP	cc_EQ, ?LBB2_5
?LBB2_3:
	MOVBZ	R11, RL2
	MOVBZ	R12, RL6
	CMP	R12, R11
	JMP	cc_EQ, ?LBB2_7
; %bb.4:                                ; %for.cond1.i
	MOVB	RL6, [R10+]
	MOVBZ	R6, RL6
	CMP	R6, #0
	JMP	cc_NE, ?LBB2_3
?LBB2_5:
	ADD	R5, #1
	MOV	R2, R4
	ADD	R2, R5
	MOVB	RL2, [R2]
	MOVBZ	R2, RL2
	JMP	cc_NE, ?LBB2_2
?LBB2_6:
	MOV	R4, #0
	JMP	cc_UC, ?LBB2_8
?LBB2_7:
	ADD	R4, R5
?LBB2_8:
	MOV	R6, [R0+]
	RETS
_strpbrk?F	ENDP
STRSPN_PR	ENDS
	END
