$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRSTR_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strstr
_strstr:
_strstr?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R4, R12
	MOVB	RL5, [R13]
	MOVBZ	R5, RL5
	JMP	cc_EQ, ?LBB0_8
; %bb.1:                                ; %for.cond.preheader
	MOVB	RL1, [R4]
	MOVBZ	R1, RL1
	JMP	cc_EQ, ?LBB0_7
; %bb.2:                                ; %land.rhs.preheader.preheader
	ADD	R13, #1
?LBB0_3:
	MOV	R1, #0
	MOV	R2, R5
?LBB0_4:
	MOV	R3, R4
	ADD	R3, R1
	MOVB	RL3, [R3]
	MOVBZ	R3, RL3
	MOVBZ	R2, RL2
	CMP	R3, R2
	JMP	cc_NE, ?LBB0_6
; %bb.5:                                ; %while.body
	MOV	R2, R13
	ADD	R2, R1
	MOVB	RL2, [R2]
	MOVBZ	R2, RL2
	ADD	R1, #1
	CMP	R2, #0
	JMP	cc_NE, ?LBB0_4
	JMP	cc_UC, ?LBB0_8
?LBB0_6:
	MOVB	RL1, [R4+#1]
	ADD	R4, #1
	MOVBZ	R1, RL1
	JMP	cc_NE, ?LBB0_3
?LBB0_7:
	MOV	R4, #0
?LBB0_8:
	RETS
_strstr?F	ENDP
STRSTR_PR	ENDS
	END
