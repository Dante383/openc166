$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
MEMCPY_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_memcpy
_memcpy:
_memcpy?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R4, R12
	CMP	R14, #0
	JMP	cc_EQ, ?LBB0_3
; %bb.1:                                ; %while.body.preheader
	MOV	R5, R4
?LBB0_2:
	SUB	R14, #1
	MOVB	RL1, [R13+]
	MOVB	[R5], RL1
	ADD	R5, #1
	CMP	R14, #0
	JMP	cc_NE, ?LBB0_2
?LBB0_3:
	RETS
_memcpy?F	ENDP
MEMCPY_PR	ENDS
	END
