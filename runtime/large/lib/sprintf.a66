$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
SPRINTF_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_vsnprintf
_vsnprintf:
_vsnprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #14
	MOV	R6, R14
	MOV	R4, [R0+#16]
	MOV	R5, [R0+#18]
	MOV	R1, [R0+#20]
	MOV	R2, [R0+#22]
	MOV	R3, R0
	ADD	R3, #8
	MOV	R10, R3
	AND	R10, #16382
	SHR	R3, #13
	AND	R3, #6
	MOV	R15, [R3+#65024]
	MOV	R14, R15
	SHL	R14, #14
	OR	R14, R10
	SHR	R15, #2
	MOV	[R0+#10], R13
	MOV	[R0+#8], R12
	MOV	R3, #1
	CMP	R6, #0
	JMP	cc_NE, ?LBB0_2
; %bb.1:                                ; %entry
	MOV	R3, #0
?LBB0_2:
	AND	R3, #1
	MOV	R10, R6
	SUB	R10, R3
	MOV	[R0+#12], R10
	MOV	[R0+#6], R2
	MOV	[R0+#4], R1
	MOV	[R0+#2], R5
	MOV	[R0], R4
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	CALLS	SEG ___c166_format, SOF ___c166_format
	CMP	R6, #0
	JMP	cc_EQ, ?LBB0_4
; %bb.3:                                ; %if.then
	MOV	R5, [R0+#10]
	MOV	R1, [R0+#8]
	MOV	R2, #0
	EXTS	R5, #1
	MOVB	[R1], RL2
?LBB0_4:
	ADD	R0, #14
	MOV	R6, [R0+]
	RETS
_vsnprintf?F	ENDP
_put:
_put?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R4, [R0+#4]
	JMP	cc_EQ, ?LBB1_4
; %bb.1:                                ; %land.rhs.preheader
	MOV	R5, R12
	MOV	R1, R13
	ADD	R5, #4
	ADDC	R1, #0
	EXTS	R1, #1
	MOV	R3, [R5]
	MOV	R2, R12
	ADD	R2, #2
?LBB1_2:
	CMP	R3, #0
	JMP	cc_EQ, ?LBB1_4
; %bb.3:                                ; %for.body
	MOV	R10, R14
	MOV	R11, R15
	ADD	R10, #1
	ADDC	R11, #0
	EXTS	R15, #1
	MOVB	RL3, [R14]
	MOVBZ	R3, RL3
	EXTS	R13, #1
	MOV	R14, [R2]
	EXTS	R13, #1
	MOV	R15, [R12]
	MOV	R6, R14
	MOV	R7, R15
	ADD	R7, #1
	ADDC	R6, #0
	EXTS	R13, #1
	MOV	[R2], R6
	EXTS	R13, #1
	MOV	[R12], R7
	EXTS	R14, #1
	MOVB	[R15], RL3
	SUB	R4, #1
	EXTS	R1, #1
	MOV	R3, [R5]
	SUB	R3, #1
	EXTS	R1, #1
	MOV	[R5], R3
	MOV	R14, R10
	MOV	R15, R11
	CMP	R4, #0
	JMP	cc_NE, ?LBB1_2
?LBB1_4:
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	RETS
_put?F	ENDP
	PUBLIC	_vsprintf
_vsprintf:
_vsprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #14
	MOV	R1, [R0+#14]
	MOV	R2, [R0+#16]
	MOV	R4, R0
	ADD	R4, #8
	MOV	R3, R4
	AND	R3, #16382
	SHR	R4, #13
	AND	R4, #6
	MOV	R4, [R4+#65024]
	MOV	R5, R4
	SHL	R5, #14
	OR	R5, R3
	SHR	R4, #2
	MOV	[R0+#10], R13
	MOV	[R0+#8], R12
	MOV	R3, #65534
	MOV	[R0+#12], R3
	MOV	[R0+#6], R2
	MOV	[R0+#4], R1
	MOV	[R0+#2], R15
	MOV	[R0], R14
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R5
	MOV	R15, R4
	CALLS	SEG ___c166_format, SOF ___c166_format
	MOV	R5, [R0+#10]
	MOV	R1, [R0+#8]
	MOV	R2, #0
	EXTS	R5, #1
	MOVB	[R1], RL2
	ADD	R0, #14
	RETS
_vsprintf?F	ENDP
	PUBLIC	_snprintf
_snprintf:
_snprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R6
	SUB	R0, #18
	MOV	R6, R14
	MOV	R4, [R0+#20]
	MOV	R5, [R0+#22]
	MOV	R3, R0
	ADD	R3, #24
	MOV	R1, R3
	SHR	R1, #13
	AND	R1, #6
	MOV	R1, [R1+#65024]
	MOV	R2, R1
	SHR	R2, #2
	MOV	[R0+#10], R2
	AND	R3, #16382
	SHL	R1, #14
	OR	R1, R3
	MOV	[R0+#8], R1
	MOV	R3, R0
	ADD	R3, #12
	MOV	R10, R3
	AND	R10, #16382
	SHR	R3, #13
	AND	R3, #6
	MOV	R15, [R3+#65024]
	MOV	R14, R15
	SHL	R14, #14
	OR	R14, R10
	SHR	R15, #2
	MOV	[R0+#14], R13
	MOV	[R0+#12], R12
	MOV	R3, #1
	CMP	R6, #0
	JMP	cc_NE, ?LBB3_2
; %bb.1:                                ; %entry
	MOV	R3, #0
?LBB3_2:
	AND	R3, #1
	MOV	R10, R6
	SUB	R10, R3
	MOV	[R0+#16], R10
	MOV	[R0+#6], R2
	MOV	[R0+#4], R1
	MOV	[R0+#2], R5
	MOV	[R0], R4
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	CALLS	SEG ___c166_format, SOF ___c166_format
	CMP	R6, #0
	JMP	cc_EQ, ?LBB3_4
; %bb.3:                                ; %if.then.i
	MOV	R5, [R0+#14]
	MOV	R1, [R0+#12]
	MOV	R2, #0
	EXTS	R5, #1
	MOVB	[R1], RL2
?LBB3_4:
	ADD	R0, #18
	MOV	R6, [R0+]
	RETS
_snprintf?F	ENDP
	PUBLIC	_sprintf
_sprintf:
_sprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #18
	MOV	R4, R0
	ADD	R4, #18
	MOV	R5, R4
	SHR	R5, #13
	AND	R5, #6
	MOV	R1, [R5+#65024]
	MOV	R2, R1
	SHR	R2, #2
	MOV	[R0+#10], R2
	AND	R4, #16382
	SHL	R1, #14
	OR	R1, R4
	MOV	[R0+#8], R1
	MOV	R4, R0
	ADD	R4, #12
	MOV	R3, R4
	AND	R3, #16382
	SHR	R4, #13
	AND	R4, #6
	MOV	R4, [R4+#65024]
	MOV	R5, R4
	SHL	R5, #14
	OR	R5, R3
	SHR	R4, #2
	MOV	[R0+#14], R13
	MOV	[R0+#12], R12
	MOV	R3, #65534
	MOV	[R0+#16], R3
	MOV	[R0+#6], R2
	MOV	[R0+#4], R1
	MOV	[R0+#2], R15
	MOV	[R0], R14
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R5
	MOV	R15, R4
	CALLS	SEG ___c166_format, SOF ___c166_format
	MOV	R5, [R0+#14]
	MOV	R1, [R0+#12]
	MOV	R2, #0
	EXTS	R5, #1
	MOVB	[R1], RL2
	ADD	R0, #18
	RETS
_sprintf?F	ENDP
	EXTRN	___c166_format : FAR
SPRINTF_PR	ENDS
	END
