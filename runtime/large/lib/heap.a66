$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
HEAP_HC	SECTION	HCONST WORD PUBLIC 'CHUGEROM'
	PUBLIC	___c166_heap_size
	EVEN
___c166_heap_size:
	DW	1024
HEAP_HC	ENDS
C166_HBSS	SECTION	HDATA WORD PUBLIC 'CHUGE'
	PUBLIC	___c166_heap
___c166_heap:
	DSB	1024
C166_HBSS	ENDS
	END
