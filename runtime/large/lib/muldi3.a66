$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
MULDI3_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	___muldi3                       ; -- Begin function __muldi3
___muldi3:                              ; @__muldi3
___muldi3?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #70
	MOV	[R0], R12                       ; 2-byte Folded Spill
	MOV	R4, [R0+#92]
	MOV	[R0+#12], R4                    ; 2-byte Folded Spill
	MOV	R4, [R0+#90]
	MOV	[R0+#10], R4                    ; 2-byte Folded Spill
	MOV	R4, [R0+#88]
	MOV	[R0+#8], R4                     ; 2-byte Folded Spill
	MOV	R4, [R0+#86]
	MOV	[R0+#6], R4                     ; 2-byte Folded Spill
	MOV	R4, [R0+#84]
	MOV	[R0+#4], R4                     ; 2-byte Folded Spill
	MOV	R4, [R0+#82]
	MOV	[R0+#2], R4                     ; 2-byte Folded Spill
	MOV	R14, [R0+#80]
	MOV	R15, [R0+#78]
	MOV	R10, #0
	MOV	[R0+#52], R10
	MOV	[R0+#50], R10
	MOV	[R0+#48], R10
	MOV	[R0+#46], R10
	MOV	R2, R0
	ADD	R2, #30
	MOV	R13, R0
	ADD	R13, #62
	MOV	R8, R0
	ADD	R8, #14
	MOV	R5, R0
	ADD	R5, #54
	MOV	R12, R10
	MOV	R6, R10
?LBB0_1:                                ; %for.body
                                        ; =>This Inner Loop Header: Depth=1
	MOV	[R0+#44], R10
	MOV	[R0+#42], R10
	MOV	[R0+#40], R10
	MOV	[R0+#38], R10
	MOV	[R0+#30], R15
	MOV	[R0+#32], R14
	MOV	R4, [R0+#2]                     ; 2-byte Folded Reload
	MOV	[R0+#34], R4
	MOV	R4, [R0+#4]                     ; 2-byte Folded Reload
	MOV	[R0+#36], R4
	MOV	R9, R12
	SHR	R9, #3
	AND	R9, #6
	MOV	R7, R2
	ADD	R7, R9
	MOV	R3, [R7]
	MOV	R1, R12
	AND	R1, #15
	SHR	R3, R1
	MOV	R7, [R7+#2]
	SHL	R7, #1
	MOV	R11, R1
	XOR	R11, #15
	SHL	R7, R11
	OR	R7, R3
	MOV	R3, R6
	SHL	R3, #1
	MOV	R4, R13
	ADD	R4, R3
	MOV	[R4], R7
	MOV	[R0+#28], R10
	MOV	[R0+#26], R10
	MOV	[R0+#24], R10
	MOV	[R0+#22], R10
	MOV	R4, [R0+#6]                     ; 2-byte Folded Reload
	MOV	[R0+#14], R4
	MOV	R4, [R0+#8]                     ; 2-byte Folded Reload
	MOV	[R0+#16], R4
	MOV	R4, [R0+#10]                    ; 2-byte Folded Reload
	MOV	[R0+#18], R4
	MOV	R4, [R0+#12]                    ; 2-byte Folded Reload
	MOV	[R0+#20], R4
	ADD	R9, R8
	MOV	R4, [R9]
	SHR	R4, R1
	MOV	R1, [R9+#2]
	SHL	R1, #1
	SHL	R1, R11
	OR	R1, R4
	ADD	R3, R5
	MOV	[R3], R1
	ADD	R6, #1
	ADD	R12, #16
	CMP	R6, #4
	JMP	cc_NE, ?LBB0_1
; %bb.2:                                ; %for.cond14.preheader.preheader
	MOV	R1, #0
	MOV	R2, R1
?LBB0_3:                                ; %for.cond14.preheader
                                        ; =>This Loop Header: Depth=1
                                        ;     Child Loop BB0_4 Depth 2
	MOV	R4, R2
	SHL	R4, #1
	ADD	R4, R13
	MOV	R3, [R4]
	MOV	R10, R1
	MOV	R12, R1
	MOV	R11, R1
?LBB0_4:                                ; %for.body18
                                        ;   Parent Loop BB0_3 Depth=1
                                        ; =>  This Inner Loop Header: Depth=2
	MOV	R4, R2
	ADD	R4, R10
	MOV	R14, R10
	SHL	R14, #1
	ADD	R14, R5
	MOV	R14, [R14]
	MULU	R14, R3
	MOV	R15, MDH
	MUL	R14, R3
	MOV	R14, MDL
	SHL	R4, #1
	MOV	R6, R0
	ADD	R6, #46
	ADD	R6, R4
	MOV	R4, [R6]
	MOV	R7, #0
	ADD	R12, R4
	ADDC	R11, R7
	ADD	R12, R14
	ADDC	R11, R15
	MOV	[R6], R12
	ADD	R10, #1
	MOV	R4, R2
	ADD	R4, R10
	MOV	R12, R11
	MOV	R11, R7
	CMP	R4, #4
	JMP	cc_NE, ?LBB0_4
; %bb.5:                                ; %for.cond.cleanup17
                                        ;   in Loop: Header=BB0_3 Depth=1
	ADD	R2, #1
	CMP	R2, #4
	JMP	cc_NE, ?LBB0_3
; %bb.6:                                ; %for.cond.cleanup11
	MOV	R4, [R0+#46]
	MOV	R5, [R0+#48]
	MOV	R1, [R0+#50]
	MOV	R2, [R0+#52]
	MOV	R3, [R0]                        ; 2-byte Folded Reload
	MOV	[R3+#6], R2
	MOV	[R3+#4], R1
	MOV	[R3+#2], R5
	MOV	[R3], R4
	ADD	R0, #70
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
___muldi3?F	ENDP
                                        ; -- End function
MULDI3_PR	ENDS
	END
