$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
MEMCMP_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_memcmp
_memcmp:
_memcmp?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R1, [R0]
	MOV	R5, #0
	CMP	R1, #0
	JMP	cc_EQ, ?LBB0_3
?LBB0_1:
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOVBZ	R4, RL4
	EXTS	R15, #1
	MOVB	RL2, [R14]
	MOVBZ	R2, RL2
	MOVBZ	R2, RL2
	CMP	R4, R2
	JMP	cc_NE, ?LBB0_4
; %bb.2:                                ; %for.inc
	SUB	R1, #1
	ADD	R12, #1
	ADDC	R13, #0
	ADD	R14, #1
	ADDC	R15, #0
	CMP	R1, #0
	JMP	cc_NE, ?LBB0_1
?LBB0_3:
	MOV	R4, R5
	RETS
?LBB0_4:
	SUB	R4, R2
	RETS
_memcmp?F	ENDP
MEMCMP_PR	ENDS
	END
