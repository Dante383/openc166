$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRCMP_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strcmp
_strcmp:
_strcmp?F	PROC	FAR
; %bb.0:                                ; %entry
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOVBZ	R5, RL4
	JMP	cc_EQ, ?LBB0_5
?LBB0_1:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	MOVBZ	R5, RL5
	MOVBZ	R1, RL4
	CMP	R1, R5
	JMP	cc_NE, ?LBB0_4
; %bb.2:                                ; %while.body
	ADD	R12, #1
	ADDC	R13, #0
	ADD	R14, #1
	ADDC	R15, #0
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOVBZ	R5, RL4
	JMP	cc_NE, ?LBB0_1
; %bb.3:
	MOV	R4, #0
?LBB0_4:
	MOVBZ	R4, RL4
	JMP	cc_UC, ?LBB0_6
?LBB0_5:
	MOV	R4, #0
?LBB0_6:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	SUB	R4, R5
	RETS
_strcmp?F	ENDP
	PUBLIC	_strcoll
_strcoll:
_strcoll?F	PROC	FAR
; %bb.0:                                ; %entry
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOVBZ	R5, RL4
	JMP	cc_EQ, ?LBB1_5
?LBB1_1:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	MOVBZ	R5, RL5
	MOVBZ	R1, RL4
	CMP	R1, R5
	JMP	cc_NE, ?LBB1_4
; %bb.2:                                ; %while.body.i
	ADD	R12, #1
	ADDC	R13, #0
	ADD	R14, #1
	ADDC	R15, #0
	EXTS	R13, #1
	MOVB	RL4, [R12]
	MOVBZ	R4, RL4
	MOVBZ	R5, RL4
	JMP	cc_NE, ?LBB1_1
; %bb.3:
	MOV	R4, #0
?LBB1_4:
	MOVBZ	R4, RL4
	JMP	cc_UC, ?LBB1_6
?LBB1_5:
	MOV	R4, #0
?LBB1_6:
	EXTS	R15, #1
	MOVB	RL5, [R14]
	MOVBZ	R5, RL5
	SUB	R4, R5
	RETS
_strcoll?F	ENDP
STRCMP_PR	ENDS
	END
