$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRXFRM_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strxfrm
_strxfrm:
_strxfrm?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #6
	MOV	R6, R15
	MOV	R7, R14
	MOV	[R0+#4], R13
	MOV	[R0+#2], R12
	MOV	R9, [R0+#14]
	MOV	R12, R7
	MOV	R13, R6
	CALLS	SEG _strlen, SOF _strlen
	MOV	R8, R4
	CMP	R9, #0
	JMP	cc_EQ, ?LBB0_4
; %bb.1:                                ; %if.then
	CMP	R8, R9
	JMP	cc_UGE, ?LBB0_3
; %bb.2:
	MOV	R9, R8
	ADD	R9, #1
?LBB0_3:
	MOV	[R0], R9
	MOV	R12, [R0+#2]
	MOV	R13, [R0+#4]
	MOV	R14, R7
	MOV	R15, R6
	CALLS	SEG _memcpy, SOF _memcpy
?LBB0_4:
	MOV	R4, R8
	ADD	R0, #6
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
_strxfrm?F	ENDP
	EXTRN	_strlen : FAR
	EXTRN	_memcpy : FAR
STRXFRM_PR	ENDS
	END
