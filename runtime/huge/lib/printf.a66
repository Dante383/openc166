$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
PRINTF_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_vfprintf
_vfprintf:
_vfprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #50
	MOV	[R0+#8], R13
	MOV	R7, R12
	MOV	R4, [R0+#58]
	MOV	R5, [R0+#60]
	MOV	R1, R0
	ADD	R1, #10
	MOV	R2, R1
	AND	R2, #16382
	SHR	R1, #13
	AND	R1, #6
	MOV	R6, [R1+#65024]
	MOV	R9, R6
	SHL	R9, #14
	OR	R9, R2
	SHR	R6, #2
	MOV	[R0+#12], R13
	MOV	[R0+#10], R7
	MOV	R1, #0
	MOV	[R0+#16], R1
	MOV	[R0+#14], R1
	MOV	[R0+#6], R5
	MOV	[R0+#4], R4
	MOV	[R0+#2], R15
	MOV	[R0], R14
	MOV	R12, #SOF _put
	MOV	R13, #SEG _put
	MOV	R14, R9
	MOV	R15, R6
	CALLS	SEG ___c166_format, SOF ___c166_format
	MOV	R8, R4
	MOV	R12, R9
	MOV	R13, R6
	CALL	_flush
	MOV	R12, R7
	MOV	R13, [R0+#8]
	CALLS	SEG _ferror, SOF _ferror
	CMP	R4, #0
	JMP	cc_EQ, ?LBB0_2
; %bb.1:                                ; %entry
	MOV	R8, #65535
?LBB0_2:
	MOV	R4, R8
	ADD	R0, #50
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
_vfprintf?F	ENDP
_put:
_put?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #16
	MOV	R9, R15
	MOV	R8, R14
	MOV	[R0+#6], R13
	MOV	[R0+#4], R12
	MOV	R6, [R0+#26]
	MOV	R7, [R0+#24]
	MOV	R4, R7
	OR	R4, R6
	JMP	cc_EQ, ?LBB1_5
; %bb.1:                                ; %while.body.lr.ph
	MOV	R5, [R0+#4]
	MOV	R14, R5
	MOV	R4, [R0+#6]
	MOV	R15, R4
	ADD	R14, #4
	ADDC	R15, #0
	ADD	R5, #8
	ADDC	R4, #0
	MOV	[R0+#8], R4
	MOV	[R0+#10], R5
	EXTS	R15, #1
	MOV	R4, [R14]
	MOV	R5, R15
	MOV	R1, R14
	ADD	R1, #2
	ADDC	R5, #0
	MOV	[R0+#14], R5
	MOV	[R0+#12], R1
	EXTS	R5, #1
	MOV	R5, [R1]
	MOV	[R0+#2], R14
	MOV	[R0], R15
?LBB1_2:
	MOV	R1, R4
	XOR	R1, #32
	OR	R1, R5
	JMP	cc_NE, ?LBB1_4
; %bb.3:                                ; %if.then
	MOV	R12, [R0+#4]
	MOV	R13, [R0+#6]
	CALL	_flush
	MOV	R15, [R0]
	MOV	R14, [R0+#2]
	EXTS	R15, #1
	MOV	R4, [R14]
	MOV	R5, [R0+#14]
	MOV	R1, [R0+#12]
	EXTS	R5, #1
	MOV	R5, [R1]
?LBB1_4:
	ADD	R7, #65535
	ADDC	R6, #65535
	MOV	R1, R8
	MOV	R2, R9
	ADD	R1, #1
	ADDC	R2, #0
	EXTS	R9, #1
	MOVB	RL3, [R8]
	MOVBZ	R3, RL3
	MOV	R10, R4
	MOV	R11, R5
	ADD	R10, #1
	ADDC	R11, #0
	EXTS	R15, #1
	MOV	[R14], R10
	MOV	R12, [R0+#14]
	MOV	R13, [R0+#12]
	EXTS	R12, #1
	MOV	[R13], R11
	MOV	R12, [R0+#10]
	MOV	R13, [R0+#8]
	ADD	R12, R4
	ADDC	R13, R5
	EXTS	R13, #1
	MOVB	[R12], RL3
	MOV	R3, R7
	OR	R3, R6
	MOV	R4, R10
	MOV	R5, R11
	MOV	R8, R1
	MOV	R9, R2
	CMP	R3, #0
	JMP	cc_NE, ?LBB1_2
?LBB1_5:
	ADD	R0, #16
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
_put?F	ENDP
_flush:
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #12
	MOV	R14, R13
	MOV	R13, R12
	MOV	R6, R13
	MOV	R7, R14
	ADD	R6, #4
	ADDC	R7, #0
	EXTS	R7, #1
	MOV	R4, [R6]
	MOV	R8, R6
	MOV	R9, R7
	ADD	R8, #2
	ADDC	R9, #0
	EXTS	R9, #1
	MOV	R5, [R8]
	MOV	R1, R4
	OR	R1, R5
	JMP	cc_EQ, ?LBB2_3
; %bb.1:                                ; %land.lhs.true
	MOV	R1, R14
	MOV	R2, R13
	MOV	[R0+#10], R1
	MOV	[R0+#8], R2
	EXTS	R1, #1
	MOV	R1, [R2]
	MOV	R3, R14
	ADD	R2, #2
	ADDC	R3, #0
	MOV	[R0+#6], R2
	MOV	[R0+#4], R3
	EXTS	R3, #1
	MOV	R2, [R2]
	EXTS	R2, #1
	MOV	R12, [R1]
	ADD	R13, #8
	ADDC	R14, #0
	MOV	[R0+#2], R5
	MOV	[R0], R4
	CALLS	SEG __write, SOF __write
	EXTS	R7, #1
	MOV	R1, [R6]
	EXTS	R9, #1
	MOV	R2, [R8]
	XOR	R2, R5
	XOR	R1, R4
	OR	R1, R2
	JMP	cc_EQ, ?LBB2_3
; %bb.2:                                ; %if.then
	MOV	R4, [R0+#10]
	MOV	R5, [R0+#8]
	EXTS	R4, #1
	MOV	R4, [R5]
	MOV	R5, [R0+#6]
	MOV	R1, [R0+#4]
	EXTS	R1, #1
	MOV	R5, [R5]
	ADD	R4, #4
	ADDC	R5, #0
	EXTS	R5, #1
	MOVB	RL1, [R4]
	MOVBZ	R1, RL1
	OR	R1, #2
	EXTS	R5, #1
	MOVB	[R4], RL1
?LBB2_3:
	MOV	R4, #0
	EXTS	R7, #1
	MOV	[R6], R4
	EXTS	R9, #1
	MOV	[R8], R4
	ADD	R0, #12
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RET
	PUBLIC	_fprintf
_fprintf:
_fprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #8
	MOV	R4, R0
	ADD	R4, #8
	MOV	R5, R4
	SHR	R5, #13
	AND	R5, #6
	MOV	R5, [R5+#65024]
	MOV	R1, R5
	SHR	R1, #2
	MOV	[R0+#6], R1
	AND	R4, #16382
	SHL	R5, #14
	OR	R5, R4
	MOV	[R0+#4], R5
	MOV	[R0+#2], R1
	MOV	[R0], R5
	CALLS	SEG _vfprintf, SOF _vfprintf
	ADD	R0, #8
	RETS
_fprintf?F	ENDP
	PUBLIC	_vprintf
_vprintf:
_vprintf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #4
	MOV	R4, R13
	MOV	R5, R12
	MOV	[R0+#2], R15
	MOV	[R0], R14
	MOV	R12, #SOF (___c166_iob+6)
	MOV	R13, #SEG (___c166_iob+6)
	MOV	R14, R5
	MOV	R15, R4
	CALLS	SEG _vfprintf, SOF _vfprintf
	ADD	R0, #4
	RETS
_vprintf?F	ENDP
	PUBLIC	_printf
_printf:
_printf?F	PROC	FAR
; %bb.0:                                ; %entry
	SUB	R0, #8
	MOV	R15, R13
	MOV	R14, R12
	MOV	R4, R0
	ADD	R4, #8
	MOV	R5, R4
	SHR	R5, #13
	AND	R5, #6
	MOV	R5, [R5+#65024]
	MOV	R1, R5
	SHR	R1, #2
	MOV	[R0+#6], R1
	AND	R4, #16382
	SHL	R5, #14
	OR	R5, R4
	MOV	[R0+#4], R5
	MOV	[R0+#2], R1
	MOV	[R0], R5
	MOV	R12, #SOF (___c166_iob+6)
	MOV	R13, #SEG (___c166_iob+6)
	CALLS	SEG _vfprintf, SOF _vfprintf
	ADD	R0, #8
	RETS
_printf?F	ENDP
	EXTRN	___c166_format : NEAR
	EXTRN	_ferror : NEAR
	EXTRN	__write : NEAR
	EXTRN	___c166_iob : WORD
PRINTF_PR	ENDS
	END
