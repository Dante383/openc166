$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
FPUTC_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_fputc
_fputc:
_fputc?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #6
	MOV	R6, R14
	MOV	R7, R13
	MOV	R4, R12
	MOV	R5, R0
	ADD	R5, #5
	MOV	R1, R5
	AND	R1, #16383
	SHR	R5, #13
	AND	R5, #6
	MOV	R14, [R5+#65024]
	MOV	R13, R14
	SHL	R13, #14
	OR	R13, R1
	SHR	R14, #2
	MOVB	[R0+#5], RL4
	EXTS	R6, #1
	MOV	R12, [R7]
	MOV	R4, #0
	MOV	[R0+#2], R4
	MOV	R4, #1
	MOV	[R0], R4
	CALLS	SEG __write, SOF __write
	XOR	R4, #1
	OR	R4, R5
	JMP	cc_NE, ?LBB0_2
; %bb.1:                                ; %if.end
	MOVB	RL4, [R0+#5]
	MOVBZ	R4, RL4
	JMP	cc_UC, ?LBB0_3
?LBB0_2:
	ADD	R7, #4
	ADDC	R6, #0
	EXTS	R6, #1
	MOVB	RL4, [R7]
	MOVBZ	R4, RL4
	OR	R4, #2
	EXTS	R6, #1
	MOVB	[R7], RL4
	MOV	R4, #65535
?LBB0_3:
	ADD	R0, #6
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	RETS
_fputc?F	ENDP
	PUBLIC	_putc
_putc:
_putc?F	PROC	FAR
; %bb.0:                                ; %entry
	CALLS	SEG _fputc, SOF _fputc
	RETS
_putc?F	ENDP
	PUBLIC	_putchar
_putchar:
_putchar?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R13, #SOF (___c166_iob+6)
	MOV	R14, #SEG (___c166_iob+6)
	CALLS	SEG _fputc, SOF _fputc
	RETS
_putchar?F	ENDP
	EXTRN	__write : NEAR
	EXTRN	___c166_iob : WORD
FPUTC_PR	ENDS
	END
