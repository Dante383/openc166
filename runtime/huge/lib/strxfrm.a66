$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRXFRM_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strxfrm
_strxfrm:
_strxfrm?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R9
	MOV	[-R0], R8
	MOV	[-R0], R7
	MOV	[-R0], R6
	SUB	R0, #12
	MOV	[R0+#6], R13
	MOV	[R0+#4], R12
	MOV	R6, [R0+#22]
	MOV	R7, [R0+#20]
	MOV	[R0+#8], R14
	MOV	R12, R14
	MOV	[R0+#10], R15
	MOV	R13, R15
	CALLS	SEG _strlen, SOF _strlen
	MOV	R8, R5
	MOV	R9, R4
	MOV	R1, R7
	OR	R1, R6
	JMP	cc_EQ, ?LBB0_10
; %bb.1:                                ; %if.then
	MOV	R3, #0
	MOV	R2, #1
	MOV	R1, R2
	CMP	R9, R7
	JMP	cc_UGE, ?LBB0_11
; %bb.2:                                ; %if.then
	CMP	R8, R6
	JMP	cc_UGE, ?LBB0_12
?LBB0_3:
	CMP	R8, R6
	JMP	cc_EQ, ?LBB0_5
?LBB0_4:
	MOV	R1, R2
?LBB0_5:
	ADD	R4, #1
	ADDC	R5, #0
	CMP	R1, #0
	JMP	cc_NE, ?LBB0_7
; %bb.6:                                ; %if.then
	MOV	R4, R7
?LBB0_7:
	CMP	R1, #0
	JMP	cc_NE, ?LBB0_9
; %bb.8:                                ; %if.then
	MOV	R5, R6
?LBB0_9:
	MOV	[R0+#2], R5
	MOV	[R0], R4
	MOV	R12, [R0+#4]
	MOV	R13, [R0+#6]
	MOV	R14, [R0+#8]
	MOV	R15, [R0+#10]
	CALLS	SEG _memcpy, SOF _memcpy
?LBB0_10:
	MOV	R4, R9
	MOV	R5, R8
	ADD	R0, #12
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	MOV	R8, [R0+]
	MOV	R9, [R0+]
	RETS
?LBB0_11:
	MOV	R1, R3
	CMP	R8, R6
	JMP	cc_ULT, ?LBB0_3
?LBB0_12:
	MOV	R2, R3
	CMP	R8, R6
	JMP	cc_NE, ?LBB0_4
	JMP	cc_UC, ?LBB0_5
_strxfrm?F	ENDP
	EXTRN	_strlen : FAR
	EXTRN	_memcpy : FAR
STRXFRM_PR	ENDS
	END
