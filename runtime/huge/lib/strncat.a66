$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
STRNCAT_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_strncat
_strncat:
_strncat?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	[-R0], R7
	MOV	[-R0], R6
	MOV	R5, R13
	MOV	R4, R12
	MOV	R1, [R0+#6]
	MOV	R2, [R0+#4]
	MOV	R11, R4
	MOV	R12, R5
?LBB0_1:
	MOV	R3, R12
	MOV	R10, R11
	EXTS	R3, #1
	MOVB	RL6, [R10]
	MOVBZ	R6, RL6
	AND	R6, #255
	ADD	R11, #1
	ADDC	R12, #0
	CMP	R6, #0
	JMP	cc_NE, ?LBB0_1
; %bb.2:                                ; %for.cond.preheader
	MOV	R11, R2
	OR	R11, R1
	JMP	cc_EQ, ?LBB0_5
?LBB0_3:
	EXTS	R15, #1
	MOVB	RL6, [R14]
	MOVBZ	R6, RL6
	MOV	R7, R6
	AND	R7, #255
	JMP	cc_EQ, ?LBB0_5
; %bb.4:                                ; %for.body
	ADD	R14, #1
	ADDC	R15, #0
	MOV	R11, R10
	MOV	R12, R3
	ADD	R11, #1
	ADDC	R12, #0
	EXTS	R3, #1
	MOVB	[R10], RL6
	ADD	R2, #65535
	ADDC	R1, #65535
	MOV	R13, R2
	OR	R13, R1
	MOV	R10, R11
	MOV	R3, R12
	CMP	R13, #0
	JMP	cc_NE, ?LBB0_3
	JMP	cc_UC, ?LBB0_6
?LBB0_5:
	MOV	R11, R10
	MOV	R12, R3
?LBB0_6:
	MOV	R1, #0
	EXTS	R12, #1
	MOVB	[R11], RL1
	MOV	R6, [R0+]
	MOV	R7, [R0+]
	RETS
_strncat?F	ENDP
STRNCAT_PR	ENDS
	END
