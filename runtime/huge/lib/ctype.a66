	PUBLIC	_ispunct
_ispunct:
_ispunct?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R5, R12
	SUB	R5, #127
	MOV	R4, #0
	CMP	R5, #65442
	JMP	cc_ULT, ?LBB10_6
; %bb.1:                                ; %land.rhs
	MOV	R2, R12
	AND	R2, #95
	SUB	R2, #91
	MOV	R1, #0
	MOV	R5, #1
	MOV	R4, R5
	CMP	R2, #65510
	JMP	cc_ULT, ?LBB10_3
; %bb.2:                                ; %land.rhs
	MOV	R4, R1
?LBB10_3:
	SUB	R12, #58
	CMP	R12, #65526
	JMP	cc_ULT, ?LBB10_5
; %bb.4:                                ; %land.rhs
	MOV	R5, R1
?LBB10_5:
	AND	R4, R5
?LBB10_6:
	RETS
_ispunct?F	ENDP
