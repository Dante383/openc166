$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
CTYPE_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	_isascii
_isascii:
_isascii?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R4, #1
	CMP	R12, #128
	JMP	cc_ULT, ?LBB0_2
; %bb.1:                                ; %entry
	MOV	R4, #0
?LBB0_2:
	RETS
_isascii?F	ENDP
	PUBLIC	_isblank
_isblank:
_isblank?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R1, #0
	MOV	R5, #1
	MOV	R4, R5
	CMP	R12, #32
	JMP	cc_EQ, ?LBB1_2
; %bb.1:                                ; %entry
	MOV	R4, R1
?LBB1_2:
	CMP	R12, #9
	JMP	cc_EQ, ?LBB1_4
; %bb.3:                                ; %entry
	MOV	R5, R1
?LBB1_4:
	OR	R4, R5
	RETS
_isblank?F	ENDP
