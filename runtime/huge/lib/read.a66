$NOMACRO
$CASE
$MOD167
$SEGMENTED
$INCLUDE(REG167.INC)
	ASSUME	DPP3:SYSTEM
READ_PR	SECTION	CODE WORD PUBLIC 'CPROGRAM'
	PUBLIC	__read
__read:
__read?F	PROC	FAR
; %bb.0:                                ; %entry
	MOV	R5, [R0+#2]
	MOV	R4, [R0]
	MOV	R1, R4
	OR	R1, R5
	JMP	cc_EQ, ?LBB0_10
; %bb.1:                                ; %while.cond.preheader.preheader
	MOV	R1, #0
	MOV	R2, R1
?LBB0_2:
	JNB	S0RIR, ?LBB0_2
; %bb.3:                                ; %while.end
	BCLR	S0RIR
	MOV	R3, S0RBUF
	MOV	R10, R13
	MOV	R11, R14
	ADD	R10, R2
	ADDC	R11, R1
	EXTS	R11, #1
	MOVB	[R10], RL3
	ADD	R2, #1
	ADDC	R1, #0
	MOV	R11, #0
	MOV	R3, #1
	MOV	R10, R3
	CMP	R1, R5
	JMP	cc_UGE, ?LBB0_7
; %bb.4:                                ; %while.end
	CMP	R2, R4
	JMP	cc_UGE, ?LBB0_8
?LBB0_5:
	CMP	R1, R5
	JMP	cc_NE, ?LBB0_9
?LBB0_6:
	JB	R3.0, ?LBB0_2
	JMP	cc_UC, ?LBB0_10
?LBB0_7:
	MOV	R10, R11
	CMP	R2, R4
	JMP	cc_ULT, ?LBB0_5
?LBB0_8:
	MOV	R3, R11
	CMP	R1, R5
	JMP	cc_EQ, ?LBB0_6
?LBB0_9:
	MOV	R3, R10
	JB	R3.0, ?LBB0_2
?LBB0_10:
	RETS
__read?F	ENDP
READ_PR	ENDS
	END
