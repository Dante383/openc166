; Redefining symbols. Register files repeat definitions: DEFR may name an SFR
; again, and BIT may name a bit again, as long as the address is the same.
; Everything else is A25.
$MOD167
PSW     DEFR    0FF10H                  ; built-in SFR, same address
MDC     DEFR    0FF0EH, RW
ZEROS   DEFR    0FF1CH, R
DPP0    DEFR    0FE00H
CP      DEFR    0FE10H
SP      DEFR    0FE12H
N       BIT     PSW.0                   ; built-in bit, same address
IEN     BIT     PSW.11
MULIP   BIT     0FF10H.5
MDH     DEFR    0FE40H                  ; different address
SP      DEFR    0FE14H
V       BIT     PSW.3                   ; different bit
C       DEFB    PSW.1                   ; DEFB never repeats
E       BIT     PSW.4
E       DEFB    PSW.4
R0      DEFR    0FE00H                  ; GPR name
REG1    DEFR    0FE40H
REG1    DEFR    0FE40H
REG1    DEFR    0FE40H, W               ; the access attribute does not matter
REG4    DEFR    0FE44H
REG4    DEFR    0FE46H
EREG    DEFR    0F100H
EREG    DEFR    0F100H
REG2    DEFR    0FE48H
REG2    EQU     0FE48H
REG3    DEFR    0FE4AH
REG3    SET     0FE4AH
SET1    SET     3
SET1    DEFR    0FE40H
ADR1    DEFA    0FA00H
ADR1    DEFA    0FA00H                  ; DEFA never repeats
ADR2    DEFA    0FA02H
ADR2    DEFA    0FA04H
DB1     DEFB    0FD00H.1
DB1     DEFB    0FD00H.1                ; DEFB never repeats
DB3     DEFB    0FD00H.4
DB3     BIT     0FD00H.4                ; BIT may repeat a DEFB bit
BT1     BIT     0FD02H.1
BT1     BIT     0FD02H.1
BT2     BIT     0FD04H.1
BT2     BIT     0FD04H.2
BT3     BIT     EREG.1
BT3     BIT     0F100H.1
BREG    DEFR    0FF40H
BT4     BIT     BREG.3
BT4     BIT     0FF40H.3
EQ1     EQU     5
EQ1     EQU     5                       ; EQU never repeats
PORT    DEFR    0FFC4H
PIN4    BIT     PORT.4
PIN4    BIT     PORT.4
RED     SECTION CODE AT 0C000H
MAIN    PROC
        MOV     PSW, #1
        MOV     MDC, ZEROS
        BSET    N
        BCLR    IEN
        BSET    MULIP
        BSET    DB3
        BSET    BT1
        BSET    BT3
        BSET    BT4
        BSET    PIN4
        MOV     REG1, #2
        MOV     EREG, #3
        MOV     R1, DPP0
        RET
MAIN    ENDP
RED     ENDS
        END
