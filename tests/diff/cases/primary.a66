; Keil reads the primary controls at the top of the file before the rest,
; so this 100% sure comment is not an MPL call: $NOMPL comes below.
$MOD166
$MOD167                 ; A7: contradicts $MOD166, but is still used
$MODV2                  ; A7: contradicts $MOD166 (but not $MOD167)
$CASE
$NOCASE                 ; A7: contradicts $CASE, but is still used
$CASE TABS(4)           ; A7, and the rest of the line is ignored
$CASE                   ; A7 again: $NOCASE was given
$SYMBOLS
$SYMBOLS
$NOSYMBOLS              ; A7
$TABS(17)               ; A19: 1 to 16
$TABS(2+2)              ; A22: a plain number only
$TABS(3)
$MPL
$NOMPL                  ; A7, but MPL is off from the start
abc     EQU     1
ABC     EQU     2       ; $CASE is on
$TABS(8)                ; A8: too late

C1      SECTION CODE
P1      PROC
        EXTR    #1
        MOV     R1, R2
        RET
P1      ENDP
C1      ENDS

D1      SECTION DATA
        DB      'a	b'      ; $TABS(3): this tab is 3 spaces
	DB	'ab	c'
D1      ENDS
        END
