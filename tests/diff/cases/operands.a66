; Immediate sizing, form selection, bit addressing and operand errors.
$MOD167
OPS     SECTION CODE AT 0C000H
OPSP    PROC NEAR
        MOV     R1, #0
        MOV     R1, #15
        MOV     R1, #16
        MOV     R1, #-1
        MOV     R1, #-0
        MOV     R1, #-40000
        MOV     R1, #10000H
        MOVB    RL1, #-129
        MOVB    RL1, #255
        MOVB    RL1, #256
        ADD     R2, #3
        ADD     R2, #7
        ADD     R2, #8
        ADD     R2, #-1
        ADDB    RL2, #7
        ADDB    RL2, #8
        SHL     R1, #-1
        SHL     R1, #15
        SHL     R1, #16
        TRAP    #-1
        TRAP    #7FH
        TRAP    #80H
        EXTR    #5
        EXTR    #0
        EXTR    #4
        EXTP    #400H, #1
        EXTP    #0FFFFH, #1
        EXTP    #10000H, #1
        EXTS    #-1, #1
        EXTS    #100H, #1
        EXTS    #0FFH, #1
        BSET    PSW.3
        BSET    C
        BSET    R15.15
        BSET    0FD01H.3
        BSET    0FDFFH.7
        BSET    0FD00H.0
        BSET    0FF10H.4
        BSET    0F100H.1
        EXTR    #1
        BSET    0F100H.1
        BSET    7FH.3           ; DIVERGES: Keil silently encodes bitoff 0
        BSET    0F0H.1
        BSET    0FD00H.16
        BSET    DPP0.1
        BCLR    0FD80H.15
        BMOV    C, Z
        BMOV    PSW.0, R3.4
        BAND    C, 0FD02H.5
        BFLDL   PSW, #0FH, #05H
        BFLDH   R3, #0F0H, #50H
        ADD     DPP0, R1
        MOVB    RL1, PSW
        MOVB    PSW, RL1
        MOV     R1, SRCP0
        PUSH    SRCP0
        PUSH    PSW
        POP     R3
        MOV     [R2+#-2], R3
        MOV     R3, [R2+#1234H]
        MOV     R3, [R2 + #4]
        MOV     [ R1 ], R2
        MOV     [-R0], R1
        MOV     R1, [R0+]
        MOVB    [R1], RL2
        MOV     [R1], [R2+]
        MOV     [R1+], [R2]
        MOV     [R1], [R2]
        MOV     0FA00H, [R2]
        MOV     [R2], 0FA00H
        MOVBZ   R1, RL2
        MOVBS   R1, RH2
        MUL     R1, R2
        DIVU    R3
        CMPI1   R1, #3
        CMPD2   R1, #1234H
        mov     r1, r2
        Mov     Rl1, #1
        JMPR    cc_uc, NEXT1
NEXT1:  JMPR    NEXT2
NEXT2:  JMPA    cc_UC, 0C000H
        CALLA   cc_Z, 0C010H
        JMPI    cc_UC, [R3]
        CALLI   cc_NE, [R4]
        JMPS    1, 2000H
        CALLS   0, 0C000H
        JMPA    0C000H
        JMPS    2000H
        PCALL   R1, 0C000H
        SCXT    R1, #1234H
        SCXT    PSW, 0FA00H
        PRIOR   R1, R2
        SRST
        IDLE
        PWRDN
        DISWDT
        EINIT
        SRVWDT
        NOP
        RETP    R5
        MOV     R1
        MOV     R1, R2, R3
        ADD     R1, [R4]
        ADD     R1, [R1+]
        MOV     R1, [R2-#2]
        MOV     R1, [R2+4]
        MOVB    R1, #1
        MOV     RL1, R2
        CPL     R1
        CPLB    RL1
        NEG     R2
        NEGB    RH2
OPSP    ENDP
OPS     ENDS
        END
