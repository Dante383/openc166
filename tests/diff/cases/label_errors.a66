; LABEL with a bad type, and named directives without their name.
$NOMPL
S SECTION CODE AT 0C000H
PR PROC NEAR
X1      LABEL   BOGUS
X2:     LABEL   BOGUS
B2:B3   LABEL   NEAR
 PROC NEAR
 PROC
 EQU 5
 SET 5
 LABEL NEAR
 LABEL
 SECTION CODE
 DEFR 0FE00H
 LIT 'X'
 BIT R1.1
B4: EQU 5
B5: SECTION CODE
B6: PROC
B7: PROC NEAR
B7  ENDP
 NOP
 CALL X1
 CALL X2
 CALL B4
 RET
PR ENDP
S ENDS
 END
