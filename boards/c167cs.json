// A bare C167CS: the image as ROM on CS0 from address 0, mirrored every image
// size, and nothing else on the bus.
{
  "format": "openc166-board",
  "version": 1,
  "name": "C167CS",
  "chip": "c167cs",
  "clock_hz": "25MHz",
  "chip_selects": {
    "cs0": { "device": "rom", "name": "rom", "image": "$IMAGE" }
  }
}
