; MTOS payload: proof of execution. Writes 0BEEFH into RAM at 0C002H and
; returns. Read 0C002H back afterwards to see that the code ran.
; Gives the same bytes as payload_marker() in gkflasher's mtos_asm.py.
; See README.md in this directory for how MTOS payloads are run.

$MOD167

MARKER  EQU     0BEEFH
TARGET  EQU     0C002H          ; a header word that MTOS does not use

MTOS    SECTION CODE AT 0C014H  ; MTOS calls 0C014H
Main    PROC    FAR             ; with a far call, so RET below becomes RETS
        MOV     R4, #MARKER
        MOV     TARGET, R4
        RET
Main    ENDP
MTOS    ENDS
        END
